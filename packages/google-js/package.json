{
  "name": "@zerobias-org/types-google-js",
  "version": "1.0.36",
  "description": "JS types for Google services",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist/ .docs/ generated/",
    "generate": "npm run generate:code",
    "transpile": "tsc -b",
    "build": "npm run lint && npm run generate && npm run transpile",
    "nx:build": "npm run transpile",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx/esm ../../node_modules/mocha/bin/mocha.js --exit --extensions ts --inline-diffs --reporter=list test/*.ts",
    "test:watch": "npm run test -- --watch --reporter=min",
    "docs:tsdoc": "typedoc --plugin typedoc-plugin-markdown --out .docs",
    "docs:combine": "concat-md --toc --decrease-title-levels --dir-name-as-title .docs > README.md",
    "docs": "npm run docs:tsdoc && npm run docs:combine",
    "generate:code": "JAVA_OPTS=\"${JAVA_OPTS} -DgoogleTypesSource=../../src\" hub-generator generate -g hub-module --additional-properties supportsES6=true -p skipHubImpl=true -i ../../node_modules/@zerobias-org/types-google/models.yml -o generated/",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'test/**/*.ts'"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "team@zerobias.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/types.git",
    "directory": "packages/google-js"
  },
  "publishConfig": {
    "registry": "https://pkg.zerobias.org/"
  },
  "files": [
    "dist/src",
    "dist/generated",
    "*.md",
    "bom.json"
  ],
  "dependencies": {
    "@zerobias-org/types-core-js": "^1.2.18",
    "@zerobias-org/types-google": "^1.0.21"
  }
}
