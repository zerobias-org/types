{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "parallel": 4,
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.js"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/publish.yml"
    ]
  },
  "targetDefaults": {
    "clean": {
      "cache": false
    },
    "lint": {
      "cache": true
    },
    "generate": {
      "dependsOn": [
        "^generate"
      ],
      "cache": true
    },
    "transpile": {
      "dependsOn": [
        "generate"
      ],
      "cache": true
    },
    "nx:build": {
      "dependsOn": [
        "^nx:build",
        "lint",
        "generate"
      ],
      "cache": true
    }
  },
  "analytics": false
}